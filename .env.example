# ===== PARA O DOCKER COMPOSE =====
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin123
POSTGRES_DB=novabank_dev

# ===== PARA O SPRING BOOT =====
DB_USERNAME=admin
DB_PASSWORD=admin123
DB_NAME=novabank_dev

# ===== NVD API KEY =====
# Optional — only needed for `./mvnw verify` (OWASP Dependency-Check).
# Request one: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# ===== ADMIN BOOTSTRAP =====
# ⚠️ DEV ONLY — change this in any environment that is not local.
ADMIN_EMAIL=admin@novabank.local
ADMIN_PASSWORD=ChangeMe123!

# ===== JWT =====
# Generate a random secret: openssl rand -base64 32
JWT_SECRET=change-me-to-a-random-32-char-string