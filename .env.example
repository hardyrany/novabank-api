# ==========================================
# NovaBank - Environment Variables Example
# ==========================================
# Copy this file to .env and adjust values
# DO NOT commit .env file to the repository
# ==========================================

# IMPORTANT: This project uses TWO .env files with the SAME content:
#     1. novabank/.env                      → read by docker-compose.yml
#     2. novabank/backend/novabank-api/.env → read by Spring Boot
#
# How to set up (from repository root):
#
#   cp .env.example .env
#   cp .env.example backend/novabank-api/.env
#
# Alternative (Linux/WSL only — single source of truth via symlink):
#
#   cp .env.example .env
#   ln -s ../../.env backend/novabank-api/.env
#
# Both files MUST be kept in sync manually when changing database credentials.
# ==========================================

# ===== DATABASE =====
# POSTGRES_* → read by docker-compose.yml to create the Postgres container
# DB_*       → read by application-dev.yml to connect from Spring Boot
# Both groups MUST have the same values for consistency.
# ==========================================

POSTGRES_USER=admin
POSTGRES_PASSWORD=admin123
POSTGRES_DB=novabank_dev

DB_USERNAME=admin
DB_PASSWORD=admin123
DB_NAME=novabank_dev

# ===== NVD API KEY =====
NVD_API_KEY=

# ===== ADMIN BOOTSTRAP =====
# Used by AdminBootstrapRunner on startup to create the first ADMIN user.
# If both are set and the admin does not exist, it will be created.
# If left empty, no admin is created (useful for production where admin is managed externally).
# Leave empty in production and use a secret manager.
ADMIN_EMAIL=
ADMIN_PASSWORD=