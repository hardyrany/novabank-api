# ==========================================
# NovaBank - Environment Variables Example
# ==========================================
# Copy this file to .env and adjust values
# DO NOT commit .env file to the repository
# ==========================================

# ===== DATABASE =====
# Docker Compose and Spring Boot use the same credentials
# POSTGRES_* variables are used by docker-compose.yml
# DB_* variables are used by application-dev.yml
# Both groups MUST have the same values for consistency
# ==========================================

POSTGRES_USER=admin
POSTGRES_PASSWORD=admin123
POSTGRES_DB=novabank_dev

DB_USERNAME=admin
DB_PASSWORD=admin123
DB_NAME=novabank_dev